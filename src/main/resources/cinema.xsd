<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <!-- ===== Types simples (avec restrictions) ===== -->
    <xs:simpleType name="noteType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="10"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="anneeType">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="1888"/>
            <xs:maxInclusive value="2100"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="emailType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[^@\s]+@[^@\s]+\.[a-z]{2,}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="genreType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Action"/>
            <xs:enumeration value="Drame"/>
            <xs:enumeration value="Comédie"/>
            <xs:enumeration value="Science-fiction"/>
            <xs:enumeration value="Horreur"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Types complexes ===== -->
    <xs:complexType name="filmType">
        <xs:sequence>
            <xs:element name="titre" type="xs:string"/>
            <xs:element name="realisateur" type="xs:string"/>
            <xs:element name="annee" type="anneeType"/>
            <xs:element name="duree" type="xs:positiveInteger"/>
            <xs:element name="note" type="noteType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="genre" type="genreType" use="required"/>
        <xs:attribute name="disponible" type="xs:boolean" use="required"/>
    </xs:complexType>

    <xs:complexType name="salleType">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="capacite" type="xs:positiveInteger"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
    </xs:complexType>

    <xs:complexType name="utilisateurType">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="prenom" type="xs:string"/>
            <xs:element name="email" type="emailType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="actif" type="xs:boolean" use="required"/>
    </xs:complexType>

    <!-- ===== Élément racine ===== -->
    <xs:element name="cinema">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="films">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="film" type="filmType" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="salles">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="salle" type="salleType" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="utilisateurs">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="utilisateur" type="utilisateurType" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>